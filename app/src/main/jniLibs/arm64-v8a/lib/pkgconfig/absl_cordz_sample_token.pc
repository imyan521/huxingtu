prefix=/home/cxz/Cartographer-Android/third_party/build/install/absl
exec_prefix=${prefix}
libdir=/home/cxz/Cartographer-Android/third_party/build/install/absl/lib
includedir=/home/cxz/Cartographer-Android/third_party/build/install/absl/include

Name: absl_cordz_sample_token
Description: Abseil cordz_sample_token library
URL: https://abseil.io/
Version: 20230802
Requires: absl_config = 20230802, absl_cordz_handle = 20230802, absl_cordz_info = 20230802
Libs: -L${libdir}  -labsl_cordz_sample_token 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
