prefix=/home/cxz/Cartographer-Android/third_party/install/abseil
exec_prefix=${prefix}
libdir=/home/cxz/Cartographer-Android/third_party/install/abseil/lib
includedir=/home/cxz/Cartographer-Android/third_party/install/abseil/include

Name: absl_random_internal_distribution_caller
Description: Abseil random_internal_distribution_caller library
URL: https://abseil.io/
Version: 20230125
Requires: absl_config = 20230125, absl_utility = 20230125, absl_fast_type_id = 20230125
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -DNOMINMAX
