*.jks
*.keystore

# NDK generated files
*.o
*.a
*.so

# Windows builds package these verified ARM64 JNI libraries without rebuilding
# the full Cartographer native dependency tree.
!app/src/main/prebuiltJniLibs/
!app/src/main/prebuiltJniLibs/**/*.so

# Debug
*.log
*.trace

# Crashlytics
crashlytics.properties
crashlytics-build.properties

# Maps API keys (never commit real keys)
google_maps_api_key.xml

